# Copy to .env.local and fill in.

# Required. Neon connection string: Neon console -> your project -> Connect.
# Using the pooled connection string (host contains "-pooler") is recommended.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Optional. Set to 1 only if you run `npm start` over plain http on a host other than localhost.
# Leave unset when serving over https, so session cookies stay marked Secure.
# INSECURE_COOKIES=1
